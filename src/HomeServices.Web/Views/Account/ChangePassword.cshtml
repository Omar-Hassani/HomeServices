@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<section class="account-shell">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <partial name="_AccountNav" />
            </div>
            <div class="col-lg-9">
                <div class="panel" style="max-width: 640px">
                    <div class="panel-header">
                        <h2>تغيير كلمة المرور</h2>
                        <p>اختر كلمة مرور قوية لا تستخدمها في مواقع أخرى.</p>
                    </div>

                    <form asp-action="ChangePassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label"></label>
                            <div class="input-icon password-field">
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                <input asp-for="CurrentPassword" class="form-control" dir="ltr" autocomplete="current-password" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="إظهار كلمة المرور"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <div class="input-icon password-field">
                                <i class="fa-solid fa-key" aria-hidden="true"></i>
                                <input asp-for="NewPassword" class="form-control" dir="ltr" autocomplete="new-password" data-password-strength="#password-meter" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="إظهار كلمة المرور"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <div class="password-meter" id="password-meter" aria-live="polite">
                                <div class="password-meter-bar"><span></span></div>
                                <small class="password-meter-label">8 أحرف على الأقل، ورقم واحد على الأقل</small>
                            </div>
                            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <div class="input-icon password-field">
                                <i class="fa-solid fa-key" aria-hidden="true"></i>
                                <input asp-for="ConfirmNewPassword" class="form-control" dir="ltr" autocomplete="new-password" />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="إظهار كلمة المرور"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
                        </div>

                        <div class="panel-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-check" aria-hidden="true"></i><span class="btn-label">تحديث كلمة المرور</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
