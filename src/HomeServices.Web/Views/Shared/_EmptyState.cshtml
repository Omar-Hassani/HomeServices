@model EmptyStateViewModel
<div class="empty-state">
    <div class="empty-state-icon"><i class="@Model.Icon" aria-hidden="true"></i></div>
    <h3>@Model.Title</h3>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p>@Model.Message</p>
    }
    @if (!string.IsNullOrEmpty(Model.ActionText) && !string.IsNullOrEmpty(Model.ActionUrl))
    {
        <a class="btn btn-primary" href="@Model.ActionUrl">@Model.ActionText</a>
    }
</div>
