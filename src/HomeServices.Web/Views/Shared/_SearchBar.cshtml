@model SearchBarViewModel
<form class="search-bar" method="get" action="/Providers" role="search" data-search-form>
    <div class="search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <label for="search-q" class="visually-hidden">ما الخدمة التي تحتاجها؟</label>
        <input id="search-q" name="q" type="search" class="form-control" value="@Model.Query"
               placeholder="ما الخدمة التي تحتاجها؟" maxlength="100" autocomplete="off" />
    </div>
    <div class="search-field">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        <label for="search-area" class="visually-hidden">المنطقة</label>
        <select id="search-area" name="areaId" class="form-select">
            <option value="">كل المناطق</option>
            @foreach (var city in Model.Cities)
            {
                <optgroup label="@city.Name">
                    @foreach (var area in city.Areas)
                    {
                        <option value="@area.Id" selected="@(Model.AreaId == area.Id)">@area.Name</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span class="btn-label">ابحث</span>
    </button>
</form>

@if (Model.Suggestions.Count > 0)
{
    <div class="search-suggestions">
        <span>اقتراحات:</span>
        @foreach (var suggestion in Model.Suggestions)
        {
            <button type="button" class="suggestion-chip" data-suggestion="@suggestion">@suggestion</button>
        }
    </div>
}
