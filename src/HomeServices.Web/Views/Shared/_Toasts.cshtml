@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
<div class="toast-stack" aria-live="polite" aria-atomic="true" id="toast-stack">
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="toast toast-success" role="status" data-autoshow>
            <div class="toast-body">
                <i class="fa-solid fa-circle-check toast-icon mt-1" aria-hidden="true"></i>
                <span class="flex-grow-1">@success</span>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="toast" aria-label="إغلاق"></button>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast toast-error" role="alert" data-autoshow>
            <div class="toast-body">
                <i class="fa-solid fa-circle-exclamation toast-icon mt-1" aria-hidden="true"></i>
                <span class="flex-grow-1">@error</span>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="toast" aria-label="إغلاق"></button>
            </div>
        </div>
    }
</div>
