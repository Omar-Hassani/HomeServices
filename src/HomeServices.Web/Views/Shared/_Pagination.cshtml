@model PaginationViewModel
@if (Model.TotalPages > 1)
{
    <nav class="pagination-hs" aria-label="التنقل بين الصفحات">
        @if (Model.Page > 1)
        {
            <a class="page-link-hs" href="@Model.PageUrl(Model.Page - 1)" rel="prev" aria-label="الصفحة السابقة">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span class="d-none d-sm-inline">السابق</span>
            </a>
        }

        <div class="page-numbers">
            @foreach (var number in Model.VisiblePages())
            {
                if (number is null)
                {
                    <span class="page-gap" aria-hidden="true">…</span>
                }
                else if (number == Model.Page)
                {
                    <span class="page-link-hs is-current" aria-current="page">@number</span>
                }
                else
                {
                    <a class="page-link-hs" href="@Model.PageUrl(number.Value)" aria-label="الصفحة @number">@number</a>
                }
            }
        </div>

        @if (Model.Page < Model.TotalPages)
        {
            <a class="page-link-hs" href="@Model.PageUrl(Model.Page + 1)" rel="next" aria-label="الصفحة التالية">
                <span class="d-none d-sm-inline">التالي</span><i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </a>
        }
    </nav>
}
