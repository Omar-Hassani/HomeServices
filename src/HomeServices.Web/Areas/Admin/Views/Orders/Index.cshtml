@model OrdersPageViewModel
@{
    ViewData["Title"] = "الطلبات";
}

<div class="dash-header">
    <div>
        <h1>الطلبات</h1>
        <p>نشطة: @Model.Counts.Active · مكتملة: @Model.Counts.Completed · ملغاة ومرفوضة: @Model.Counts.Closed</p>
    </div>
</div>

<div class="admin-toolbar">
    <nav class="admin-tabs" aria-label="حالة الطلب">
        <a asp-action="Index" asp-route-q="@Model.Query" class="@(Model.Status is null ? "active" : null)">الكل</a>
        @foreach (var status in Enum.GetValues<OrderStatus>())
        {
            <a asp-action="Index" asp-route-status="@status" asp-route-q="@Model.Query" class="@(Model.Status == status ? "active" : null)">@status.GetDisplayName()</a>
        }
    </nav>
    <form method="get" class="admin-search" role="search">
        <input type="hidden" name="status" value="@Model.Status" />
        <div class="input-icon">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input name="q" value="@Model.Query" class="form-control form-control-sm" placeholder="رقم الطلب أو اسم أحد الطرفين" aria-label="بحث" />
        </div>
    </form>
</div>

@if (Model.Orders.Items.Count > 0)
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>الطلب</th>
                    <th>العميل</th>
                    <th>مقدم الخدمة</th>
                    <th>الموعد والمنطقة</th>
                    <th>الحالة</th>
                    <th>السعر</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders.Items)
                {
                    <tr class="is-clickable">
                        <td>
                            <a class="cell-link" asp-action="Details" asp-route-id="@o.Id" style="--accent: @o.CategoryAccentColor">
                                <span class="cell-icon"><i class="@o.CategoryIcon" aria-hidden="true"></i></span>
                                <span>
                                    <strong>@o.ServiceName</strong>
                                    <small dir="ltr">@o.OrderNumber</small>
                                </span>
                            </a>
                        </td>
                        <td>@o.CustomerName</td>
                        <td>@o.ProviderName</td>
                        <td>
                            <small class="d-block">@o.ScheduledDate.ToString("d MMMM yyyy")</small>
                            <small class="d-block text-secondary">@o.AreaName، @o.CityName</small>
                        </td>
                        <td><order-status value="@o.Status" /></td>
                        <td>@(o.AgreedPrice?.ToPrice() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="Model.Pagination" />
}
else
{
    <partial name="_EmptyState" model='new EmptyStateViewModel { Icon = "fa-solid fa-clipboard-list", Title = "لا توجد طلبات مطابقة" }' />
}
