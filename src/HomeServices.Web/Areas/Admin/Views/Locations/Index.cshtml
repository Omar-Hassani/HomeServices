@model IReadOnlyList<AdminCityDto>
@{
    ViewData["Title"] = "المحافظات والمناطق";
}

<div class="dash-header">
    <div>
        <h1>المحافظات والمناطق</h1>
        <p>أضف مناطق جديدة أو عطّل منطقة لإخفائها من البحث ونماذج الطلب. التعطيل لا يحذف بيانات الطلبات السابقة.</p>
    </div>
</div>

<div class="accordion area-accordion" id="locationsAccordion">
    @foreach (var city in Model)
    {
        <div class="accordion-item" id="city-@city.Id">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#city-body-@city.Id" aria-expanded="false" aria-controls="city-body-@city.Id">
                    <span class="flex-grow-1">@city.Name</span>
                    <small class="text-secondary fw-normal">@city.Areas.Count(a => a.IsActive) منطقة فعّالة</small>
                </button>
            </h2>
            <div id="city-body-@city.Id" class="accordion-collapse collapse" data-city-panel>
                <div class="accordion-body">
                    <div class="area-admin-grid">
                        @foreach (var area in city.Areas)
                        {
                            <form asp-action="SetAreaActive" asp-route-id="@area.Id" method="post" class="area-admin-chip @(area.IsActive ? null : "is-inactive")">
                                <input type="hidden" name="cityId" value="@city.Id" />
                                <input type="hidden" name="isActive" value="@((!area.IsActive).ToString().ToLowerInvariant())" />
                                <span>@area.Name</span>
                                <small title="مقدمو خدمات يعملون فيها">@area.ProvidersCount</small>
                                <button type="submit" class="icon-btn" data-no-loading title="@(area.IsActive ? "تعطيل" : "تفعيل")" aria-label="@(area.IsActive ? "تعطيل" : "تفعيل") @area.Name">
                                    <i class="fa-solid @(area.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off")" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </div>
                    <form asp-action="AddArea" method="post" class="d-flex gap-2 mt-3" style="max-width: 420px">
                        <input type="hidden" name="cityId" value="@city.Id" />
                        <input name="name" class="form-control form-control-sm" placeholder="اسم منطقة جديدة في @city.Name" required minlength="2" maxlength="80" aria-label="اسم المنطقة" />
                        <button type="submit" class="btn btn-sm btn-primary flex-shrink-0"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="btn-label">إضافة</span></button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
