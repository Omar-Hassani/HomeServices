@model PortfolioViewModel
@{
    ViewData["Title"] = "معرض الأعمال";
}

<div class="dash-header">
    <div>
        <h1>معرض الأعمال</h1>
        <p>صور أعمالك السابقة تمنح العملاء ثقة أكبر في اختيارك.</p>
    </div>
</div>

@if (Model.CanUpload)
{
    <div class="panel mb-4">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="upload-form">
            <label class="dropzone" for="portfolio-image" data-image-preview-target>
                <input id="portfolio-image" name="image" type="file" accept="image/jpeg,image/png,image/webp" class="visually-hidden" required data-image-preview />
                <span class="dropzone-empty">
                    <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
                    <strong>اختر صورة من جهازك</strong>
                    <small>JPG أو PNG أو WebP، بحد أقصى 5 ميغابايت</small>
                </span>
                <img class="dropzone-preview" alt="معاينة الصورة المختارة" hidden />
            </label>
            <div class="upload-fields">
                <label for="caption" class="form-label">وصف الصورة (اختياري)</label>
                <input id="caption" name="caption" class="form-control" maxlength="150" placeholder="مثال: تمديد كهرباء كامل لشقة في المزة" />
                <button type="submit" class="btn btn-primary mt-3 w-100">
                    <i class="fa-solid fa-upload" aria-hidden="true"></i><span class="btn-label">رفع الصورة</span>
                </button>
                <small class="form-hint text-center">@Model.Images.Count من @Model.MaxImages صور</small>
            </div>
        </form>
    </div>
}
else
{
    <div class="status-card is-info mb-4">
        <span class="status-card-icon"><i class="fa-solid fa-images" aria-hidden="true"></i></span>
        <div>
            <h2>وصلت للحد الأقصى (@Model.MaxImages صورة)</h2>
            <p>احذف صورة لتتمكن من إضافة صورة جديدة.</p>
        </div>
    </div>
}

@if (Model.Images.Count > 0)
{
    <div class="portfolio-manage-grid">
        @foreach (var image in Model.Images)
        {
            <figure class="portfolio-manage-item">
                <img src="@image.ImagePath" alt="@(image.Caption ?? "صورة من معرض الأعمال")" loading="lazy" />
                <figcaption>@(image.Caption ?? "بدون وصف")</figcaption>
                <form asp-action="Remove" asp-route-id="@image.Id" method="post">
                    <button type="submit" class="icon-btn is-danger" title="حذف الصورة" aria-label="حذف الصورة"
                            data-no-loading data-confirm="هل تريد حذف هذه الصورة من معرض أعمالك؟">
                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                    </button>
                </form>
            </figure>
        }
    </div>
}
else
{
    <partial name="_EmptyState" model='new EmptyStateViewModel {
        Icon = "fa-regular fa-images",
        Title = "معرضك فارغ",
        Message = "ارفع صوراً واضحة لأعمال أنجزتها، فهي من أكثر ما يساعد العملاء على اتخاذ القرار." }' />
}
