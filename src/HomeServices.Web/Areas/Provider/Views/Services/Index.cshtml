@model ServicesViewModel
@{
    ViewData["Title"] = "الخدمات والأسعار";
    var units = Enum.GetValues<PriceUnit>();
}

<div class="dash-header">
    <div>
        <h1>الخدمات والأسعار</h1>
        <p>حدد الخدمات التي تقدمها وسعرك لكل منها. الأسعار تظهر للعملاء كسعر تقديري.</p>
    </div>
</div>

<div class="row g-4">
    <!-- نموذج الإضافة والتعديل -->
    <div class="col-xl-5 order-xl-2">
        <div class="panel service-form-panel" id="service-form-panel">
            <div class="panel-header">
                <h2 data-form-title data-add-title="إضافة خدمة" data-edit-title="تعديل الخدمة">إضافة خدمة</h2>
                <p>اختيار خدمة مضافة مسبقاً يحدّث سعرها.</p>
            </div>

            <form asp-action="Save" method="post" novalidate id="service-form">
                <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>

                <div class="mb-3">
                    <label for="service-category" class="form-label">الفئة</label>
                    <select id="service-category" class="form-select" data-parent-select="#Form_ServiceId">
                        <option value="">كل الفئات</option>
                        @foreach (var category in Model.Catalog)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.ServiceId" class="form-label"></label>
                    <select asp-for="Form.ServiceId" class="form-select">
                        <option value="">اختر الخدمة</option>
                        @foreach (var category in Model.Catalog)
                        {
                            <optgroup label="@category.Name" data-parent="@category.Id">
                                @foreach (var service in category.Services)
                                {
                                    <option value="@service.Id">@service.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span asp-validation-for="Form.ServiceId" class="field-validation-error"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label asp-for="Form.Price" class="form-label"></label>
                        <input asp-for="Form.Price" type="text" inputmode="numeric" min="1" step="500" inputmode="numeric" class="form-control" placeholder="مثال: 50000" />
                        <span asp-validation-for="Form.Price" class="field-validation-error"></span>
                    </div>
                    <div class="col-5">
                        <label asp-for="Form.PriceUnit" class="form-label"></label>
                        <select asp-for="Form.PriceUnit" class="form-select">
                            @foreach (var unit in units)
                            {
                                <option value="@unit">@unit.GetDisplayName()</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.Notes" class="form-label"></label>
                    <input asp-for="Form.Notes" class="form-control" maxlength="300" placeholder="مثال: السعر لا يشمل قطع الغيار" />
                    <span asp-validation-for="Form.Notes" class="field-validation-error"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="fa-solid fa-check" aria-hidden="true"></i><span class="btn-label">حفظ الخدمة</span>
                    </button>
                    <button type="button" class="btn btn-ghost d-none" data-form-reset>إلغاء التعديل</button>
                </div>
            </form>
        </div>
    </div>

    <!-- قائمة الخدمات -->
    <div class="col-xl-7 order-xl-1">
        <div class="panel">
            <div class="panel-header">
                <h2>خدماتي (@Model.Services.Count)</h2>
                <p>يمكنك إضافة حتى 30 خدمة.</p>
            </div>

            @if (Model.Services.Count > 0)
            {
                <ul class="managed-list">
                    @foreach (var service in Model.Services)
                    {
                        <li style="--accent: @service.CategoryAccentColor">
                            <span class="managed-icon"><i class="@service.CategoryIcon" aria-hidden="true"></i></span>
                            <div class="managed-info">
                                <strong>@service.ServiceName</strong>
                                <small>@(string.IsNullOrWhiteSpace(service.Notes) ? service.CategoryName : $"{service.CategoryName} · {service.Notes}")</small>
                            </div>
                            <span class="managed-price">@service.Price.ToPrice(service.PriceUnit)</span>
                            <div class="managed-actions">
                                <button type="button" class="icon-btn" title="تعديل" aria-label="تعديل @service.ServiceName"
                                        data-edit-service
                                        data-category-id="@service.CategoryId"
                                        data-service-id="@service.ServiceId"
                                        data-price="@service.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"
                                        data-unit="@service.PriceUnit"
                                        data-notes="@service.Notes">
                                    <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                </button>
                                <form asp-action="Remove" asp-route-id="@service.Id" method="post">
                                    <button type="submit" class="icon-btn is-danger" title="حذف" aria-label="حذف @service.ServiceName"
                                            data-no-loading data-confirm="هل تريد حذف خدمة «@service.ServiceName» من ملفك؟">
                                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <partial name="_EmptyState" model='new EmptyStateViewModel {
                    Icon = "fa-solid fa-list-check",
                    Title = "لم تضف أي خدمة بعد",
                    Message = "أضف خدمة واحدة على الأقل مع سعرها من النموذج، ليتمكن العملاء من العثور عليك." }' />
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/search.js" asp-append-version="true"></script>
}
